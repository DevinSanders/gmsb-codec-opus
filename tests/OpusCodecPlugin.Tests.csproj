<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 ships its own in-process test host and runs as a normal
         executable, so the test project must produce an exe. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulls the plugin under test plus the SoundBoard.PluginApi SDK and
         the Concentus packages transitively. -->
    <ProjectReference Include="..\src\OpusCodecPlugin.csproj" />

    <!-- Both the SDK and NAudio.Core flow in through the plugin with
         ExcludeAssets="runtime" — at runtime the host supplies them. The
         test host IS the runtime here, so re-add both with full assets so
         their DLLs land in the test output. -->
    <PackageReference Include="SoundBoard.PluginApi" Version="1.0.0-beta.1" />
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <!-- Pinned to 7.2.2 deliberately — FluentAssertions 8.x switched to a
         paid commercial license. Do NOT upgrade. -->
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
  </ItemGroup>

</Project>
